<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebView needs this to run at all. The app itself blocks every outside request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the ledger hand updates to Holdfast -->
    <queries>
        <package android:name="com.aaron.holdfast" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ledger_icon"
        android:label="Riyal Ledger"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".LedgerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
